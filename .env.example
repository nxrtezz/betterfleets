# Core app
DEBUG=
SECRET_KEY=
DATABASE_URL=postgis://postgres:postgres@postgres:5432/postgres
REDIS_URL=redis://redis:6379
ALLOWED_HOSTS=localhost 127.0.0.1 eeveeit.uk
CSRF_TRUSTED_ORIGINS=http://localhost https://localhost
INTERNAL_IPS=127.0.0.1
APPLICATION_NAME=betterfleet
STATIC_ROOT=staticfiles
DATA_DIR=data
SITE_DOMAIN=eeveeit.uk

# Local media storage
USE_S3_STORAGE=0
MEDIA_URL=/media/
MEDIA_ROOT=media

# OAuth/Social Authentication
SOCIALACCOUNT_PROVIDERS__discord__app=
SOCIALACCOUNT_PROVIDERS__discord__secret=
SOCIALACCOUNT_PROVIDERS__github__app=
SOCIALACCOUNT_PROVIDERS__github__secret=

# Captcha
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# Frontend build-time vars
API_ROOT=http://localhost/api
NODE_ENV=development

# Route editor
ROUTE_EDITOR_ROUTER=
ROUTE_EDITOR_OSRM_URL=

# TNDS & Bods
TNDS_USERNAME=
TNDS_PASSWORD=

# BODS (Bus Open Data Service)
BODS_API_KEY=
BODS_API_AUTH_MODE=query
BODS_API_USER_AGENT=betterfleet/1.0 (+https://betterfleet.example)
# National datafeed often requires a box: minLon,minLat,maxLon,maxLat
BODS_AVL_BOUNDING_BOX=

# Realtime Trains (server-side only; never expose this token to browser code)
RTT_API_TOKEN=
# Prefer the explicitly typed variables below. RTT_API_TOKEN is retained for
# backwards compatibility but must contain an issued access/refresh token,
# not the portal token ID.
RTT_API_ACCESS_TOKEN=
RTT_API_REFRESH_TOKEN=
RTT_API_BASE_URL=https://data.rtt.io
RTT_API_VERSION=

# auth
FIDO2_RP_ID=
FIDO2_RP_NAME=
FIDO2_RP_ORIGINS=
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# PEM public key from Clerk Dashboard > Sessions > JWT templates
CLERK_JWT_KEY=
CLERK_JWKS_URL=
CLERK_JWT_ISSUER=
CLERK_JWT_AUDIENCE=
# Webhook signing secret from Clerk Dashboard > Webhooks
CLERK_WEBHOOK_SIGNING_SECRET=

# Bug reporting
DISCORD_BUG_ENDPOINT=
DISCORD_BOT_TOKEN=
DISCORD_BOT_GUILD_ID=
DISCORD_TICKET_CHANNEL_ID=
DISCORD_TICKET_CATEGORY_ID=
DISCORD_SUPPORT_ROLE_ID=
DISCORD_ALERT_CHANNEL_ID=

# Generic requests
REQUEST_DISCORD_ENDPOINT=
