# BetterFleets Environment Configuration

# Django settings
DEBUG=1
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://localhost:8000

# Database
DATABASE_URL=postgis://postgres:postgres@postgres/postgres

# Redis (optional, for caching and channels)
REDIS_URL=redis://redis:6379/0

# Email settings (optional)
EMAIL_HOST=smtp.example.com
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password

# API Keys (optional)
TFL_APP_ID=your-tfl-app-id
TFL_APP_KEY=your-tfl-app-key
NTA_API_KEY=your-nta-api-key
FLICKR_API_KEY=your-flickr-api-key
STADIA_MAPS_API_KEY=your-stadia-maps-api-key

# Turnstile (Cloudflare) for captchas
TURNSTILE_SITEKEY=0x4AAAAAAAFWiyCqdh2c-5sy
TURNSTILE_SECRET=your-turnstile-secret

# Sentry (optional, for error tracking)
SENTRY_DSN=your-sentry-dsn

# Optional: Data directory for imports
DATA_DIR=./data

# Optional: New vehicle webhook
NEW_VEHICLE_WEBHOOK_URL=

# National Rail Darwin Push Port (from opendata.nationalrail.co.uk "My Feeds")
DARWIN_STOMP_HOST=darwin-dist-44ae45.nationalrail.co.uk
DARWIN_STOMP_PORT=61613
DARWIN_STOMP_USER=
DARWIN_STOMP_PASSWORD=
# STOMP destination: "/queue/<your-queue-guid>" for Open Data accounts,
# or "/topic/darwin.pushport-v16" for enterprise feeds
DARWIN_STOMP_DESTINATION=
# S3 credentials for the daily reference data (TIPLOC/TOC names)
DARWIN_S3_ACCESS_KEY=
DARWIN_S3_SECRET_KEY=
